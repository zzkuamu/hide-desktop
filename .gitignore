# ---- 本机/隐私 ----
# WorkBuddy 工作区记忆（含本机路径、用户名、项目上下文），绝不入库
.workbuddy/
.wb/

# ---- 构建产物 ----
build/
dist/
*.spec
*.pkg
*.pyz
*.pyc
__pycache__/

# ---- 运行期日志 ----
# selftest.log 会记录桌面图标的真实点击坐标（本机行为），不入库
*.log

# ---- 二进制 ----
# 打包的 exe 是本机产物，且二进制无法审计内含字符串，不入库
*.exe
*.dll

# ---- 环境 ----
.venv/
venv/
env/
.idea/
.vscode/
